  "steps": [
    {
      "id": "step-0",
      "title": "OBJEDNÁNÍ",
      "text": "Objednejte se telefonicky, emailem nebo přes kontaktní formulář, a společně vybereme vhodný termín pro vstupní vyšetření."
    },
    {
      "id": "step-1",
      "title": "VSTUPNÍ VYŠETŘENÍ",
      "text": "První návštěva je spojená se zjištěním současného stavu orálního zdraví. Vyslechneme si, jaké máte obtíže, jaké jsou Vaše představy a přání. Provedeme důkladné vyšetření chrupu, dutiny ústní, též zhotovíme RTG snímky a fotodokumentaci."
    },
    {
      "id": "step-2",
      "title": "NÁVRH LÉČBY",
      "text": "Na základě získaných informací Vám sestavíme léčebný plán včetně předběžné cenové kalkulace ošetření."
    },
    {
      "id": "step-3",
      "title": "LÉČBA",
      "text": "Po společné domluvě naplánujeme termíny návštěv, během kterých proběhnou potřebná ošetření. Anestezie je u nás nezbytnou součástí výkonů, díky ní je ošetření bezbolestné."
    },
    {
      "id": "step-4",
      "title": "PRAVIDELNÉ KONTROLY",
      "text": "Po dokončení léčby o Vás pravidelně pečujeme prostřednictvím preventivních prohlídek a dentální hygieny."
    }
  ],
